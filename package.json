  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "20.17.57",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitest/coverage-v8": "^3.2.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "6.3.5",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
}
