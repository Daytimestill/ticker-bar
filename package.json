    "@vitejs/plugin-vue": "5.2.4",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "6.4.6",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.9"
  }
