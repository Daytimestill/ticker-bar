# 依赖与构建产物
node_modules/
dist/
src-tauri/target/
src-tauri/gen/
coverage/

# 系统与编辑器
.DS_Store
# macOS Finder 自动生成的 Icon 文件，文件名以一个回车结尾。
# 不能写成 `Icon?`——`?` 是通配符，会连 src-tauri/icons/icon.png 一起吞掉，
# 而那是构建必需的资源，缺了别人克隆下来直接编不过。
Icon[$'\r']
.vscode/
.idea/
*.swp
*.swo

# 日志与临时文件
*.log
*.tmp
*.tsbuildinfo

# 密钥与签名材料：本项目不需要任何凭证，这些规则是防手滑
.env
.env.*
!.env.example
*.p12
*.cer
*.pem
*.key
*.mobileprovision
*.keychain
*.keychain-db
